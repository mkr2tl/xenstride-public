+fn run(p: &Pending, job: Job) {
+    QUEUE_US.fetch_add(micros(p.queued_at.lock().unwrap().elapsed()), Ordering::Relaxed);
+    STARTED.fetch_add(1, Ordering::Relaxed);
+    RUNNING.fetch_add(1, Ordering::Relaxed);
