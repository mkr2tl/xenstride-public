+mod p3_tests {
+    use super::*;
+
+    fn pending(job: Job, sent: bool) -> Arc<Pending> {
+        Arc::new(Pending {
+            job: Mutex::new(Some(job)),
+            sent: std::sync::atomic::AtomicBool::new(sent),
+            queued_at: Mutex::new(std::time::Instant::now()),
+            real: AtomicUsize::new(0),
+            done: Mutex::new(false),
